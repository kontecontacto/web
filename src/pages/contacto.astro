---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { SITE, whatsappLink } from '../data/site';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto · Konte',
  url: `${SITE.url}/contacto/`,
  about: { '@id': `${SITE.url}/#organization` },
});
---

<Layout
  title="Contacto: pide presupuesto para tu software a medida | Konte"
  description={`Contacta con Konte por WhatsApp o teléfono (${SITE.phone}), email (${SITE.email}) o formulario. Presupuesto gratis para tu CRM, sistema de turnos, tickets o app a medida.`}
  jsonLd={jsonLd}
  contactProps={{ title: 'Escríbenos. Respondemos en menos de 24 h.' }}
>
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <Breadcrumbs items={[{ name: 'Contacto', href: '/contacto/' }]} />
      <h1 class="mt-6 font-display text-5xl md:text-7xl font-black uppercase tracking-tighter leading-[0.9] text-gray-900">Contacta con <span class="text-lightAccent">Konte</span></h1>
      <p class="mt-5 text-xl text-gray-600 max-w-3xl font-medium">Elige el canal que te resulte más cómodo. Detrás de todos hay una persona, no un bot.</p>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="p-6 bg-[#25D366] hover:bg-[#128C7E] text-white rounded-2xl transition-colors">
          <WhatsAppIcon class="w-8 h-8 mb-4" />
          <p class="text-xs font-black uppercase tracking-widest opacity-80">WhatsApp</p>
          <p class="font-display text-xl font-black">{SITE.phone}</p>
          <p class="text-sm mt-2 opacity-90">La forma más rápida.</p>
        </a>
        <a href={SITE.phoneHref} class="p-6 bg-gray-900 hover:bg-lightAccent text-white rounded-2xl transition-colors">
          <svg class="w-8 h-8 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          <p class="text-xs font-black uppercase tracking-widest text-gray-400">Teléfono</p>
          <p class="font-display text-xl font-black">{SITE.phone}</p>
          <p class="text-sm mt-2 text-gray-300">Llámanos en horario laboral.</p>
        </a>
        <a href={`mailto:${SITE.email}`} class="p-6 bg-white border-2 border-gray-900 hover:border-lightAccent text-gray-900 rounded-2xl transition-colors">
          <svg class="w-8 h-8 mb-4 text-lightAccent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          <p class="text-xs font-black uppercase tracking-widest text-gray-500">Email</p>
          <p class="font-display text-xl font-black break-all">{SITE.email}</p>
          <p class="text-sm mt-2 text-gray-600">Respuesta en menos de 24 h.</p>
        </a>
        <button type="button" data-calendly class="p-6 bg-white border-2 border-gray-200 hover:border-lightAccent text-gray-900 rounded-2xl transition-colors text-left">
          <svg class="w-8 h-8 mb-4 text-lightAccent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/></svg>
          <p class="text-xs font-black uppercase tracking-widest text-gray-500">Videollamada</p>
          <p class="font-display text-xl font-black">30 minutos</p>
          <p class="text-sm mt-2 text-gray-600">Elige día y hora en el calendario.</p>
        </button>
      </div>

      <p class="mt-8 text-sm text-gray-500 font-medium">📍 {SITE.city}, España · Trabajamos en remoto con toda España y Latinoamérica.</p>
    </div>
  </section>
</Layout>
