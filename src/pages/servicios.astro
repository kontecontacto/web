---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TwoWays from '../components/TwoWays.astro';
import { SITE } from '../data/site';

interface Service {
  id: string;
  image: string;
  icon: string;
  title: string;
  subtitle: string;
  description: string;
  whenToUse: string;
  benefits: string[];
  price: string;
  priceNote: string;
  need: string;
}

const cloudServices: Service[] = [
  {
    id: "plataformas-nube",
    image: "/img/servicios/webapp.webp",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H7a5 5 0 1 1 .9-9.9A6 6 0 0 1 19.5 11a4 4 0 0 1-2 8z"/><path d="M9 15h.01M12 15h.01M15 15h.01"/></svg>`,
    title: "Sistemas de gestión en la nube",
    subtitle: "CRM, ERP, turnos, tickets, inventario… con servidor propio",
    description: "Desarrollamos tu sistema completo con servidor, base de datos y dominio propios. Pensado para crecer: muchos usuarios a la vez, varias sedes y millones de registros sin despeinarse.",
    whenToUse: "Cuando tu sistema lo van a usar muchas personas, tus clientes tienen que entrar desde fuera o necesitas pagos online e integraciones con otros programas.",
    benefits: [
      "Servidor y base de datos en la nube, con copias de seguridad diarias",
      "Usuarios, roles y permisos ilimitados",
      "HTTPS, monitorización y actualizaciones de seguridad",
      "Rendimiento estable con miles de registros",
      "Soporte y mejoras continuas incluidos en la cuota",
    ],
    price: "Pago único + cuota",
    priceNote: "presupuesto cerrado en 48 h",
    need: "ERP / programa de gestión",
  },
  {
    id: "apps-moviles",
    image: "/img/servicios/forms.webp",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>`,
    title: "Apps móviles y portales de clientes",
    subtitle: "Tu negocio en el bolsillo de tu equipo y de tus clientes",
    description: "Apps que se instalan en iPhone y Android, áreas privadas para clientes y portales de pedidos. Tu equipo de campo trabaja desde el móvil y tus clientes se atienden solos.",
    whenToUse: "Si tienes técnicos, comerciales o repartidores en la calle, o si tus clientes te llaman constantemente para pedir, reservar o preguntar por el estado de algo.",
    benefits: [
      "App instalable (PWA) o publicada en App Store y Google Play",
      "Funciona sin cobertura y sincroniza al volver",
      "Escáner de QR y códigos de barras con la cámara",
      "Notificaciones y avisos al usuario",
      "Área privada de clientes con tu marca",
    ],
    price: "Pago único + cuota",
    priceNote: "presupuesto cerrado en 48 h",
    need: "App móvil o plataforma web",
  },
  {
    id: "integraciones-api",
    image: "/img/servicios/automation.webp",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 0 1 0 10h-2"/><path d="M8 12h8"/></svg>`,
    title: "Integraciones, WhatsApp y APIs",
    subtitle: "Que tus programas hablen entre ellos",
    description: "Conectamos tu sistema con WhatsApp Business, pasarelas de pago, tu programa de facturación o contabilidad, tu tienda online, Google o cualquier herramienta con API.",
    whenToUse: "Si alguien de tu equipo copia datos de un programa a otro, o si quieres avisar a tus clientes por WhatsApp de forma automática.",
    benefits: [
      "WhatsApp Business API: avisos, recordatorios y confirmaciones",
      "Cobros con tarjeta y Bizum",
      "Sincronización con facturación, contabilidad o ERP",
      "Conexión con tienda online y marketplaces",
      "Entrada automática de leads de Meta y Google Ads",
    ],
    price: "Según integración",
    priceNote: "pago único o incluido en tu proyecto",
    need: "Otra cosa / no lo tengo claro",
  },
];

const googleServices: Service[] = [
  {
    id: "mejora-hojas-calculo",
    image: "/img/servicios/sheets.webp",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 3v18"/><path d="M13 13l2 2 4-4"/></svg>`,
    title: "Optimización Pro de Google Sheets",
    subtitle: "De hojas lentas a sistemas de alto rendimiento",
    description: "Auditamos y reconstruimos tus hojas de cálculo. Eliminamos el lag, corregimos fórmulas complejas y creamos una arquitectura de datos escalable que no se rompe.",
    whenToUse: "¿Tu archivo tarda segundos en calcular? ¿Varios usuarios rompen las fórmulas sin querer? Necesitas una base técnica sólida.",
    benefits: [
      "Auditoría técnica de rendimiento y errores",
      "Arquitectura de datos relacional (Base de Datos)",
      "Protección de celdas y validación avanzada",
      "Sistemas de búsqueda y filtrado ultra-rápidos",
      "Limpieza de duplicados y normalización"
    ],
    price: "desde 300€",
    priceNote: "pago único · 0€/mes después",
    need: "Automatizar Google Sheets / AppScript",
  },
  {
    id: "automatizacion-appscript",
    image: "/img/blog/hero-automatizacion.webp",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: "Automatización con Motores AppScript",
    subtitle: "Tu empresa trabajando mientras tú descansas",
    description: "Programamos 'robots' internos que ejecutan tareas por ti: facturación automática, avisos por email, sincronización con CRMs y reportes nocturnos.",
    whenToUse: "Si hay tareas que se repiten 'cada lunes', 'cada vez que entra un pedido' o 'al final del día', la automatización es obligatoria.",
    benefits: [
      "Triggers automáticos por tiempo o evento",
      "Integración total con Gmail, Drive y Calendar",
      "Envío masivo y personalizado de documentos",
      "Conexión con APIs externas (Stripe, WhatsApp...)",
      "Registro de errores y logs de ejecución"
    ],
    price: "desde 500€",
    priceNote: "pago único · 0€/mes después",
    need: "Automatizar Google Sheets / AppScript",
  },
  {
    id: "software-customizado",
    image: "/img/blog/hero-software.webp",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>`,
    title: "Web-Apps a Medida (Ecosistema Google)",
    subtitle: "Software potente, interfaz profesional, coste cero de servidor",
    description: "Creamos aplicaciones web privadas para tu equipo. Con menús, formularios dinámicos y paneles de gestión, pero usando Google Sheets como base de datos.",
    whenToUse: "Cuando necesitas que tu equipo use una herramienta 'que parezca una App' y no una simple hoja de cálculo con pestañas interminables.",
    benefits: [
      "Interfaz de usuario (UI) moderna y limpia",
      "Control de accesos y roles (Admin/User)",
      "Gestión de flujos de trabajo (Estados/Aprobaciones)",
      "Adaptado a móviles y tablets (Responsive)",
      "Sin cuotas mensuales de alojamiento (0€/mes)"
    ],
    price: "desde 2.500€",
    priceNote: "pago único · 0€/mes después",
    need: "Automatizar Google Sheets / AppScript",
  },
  {
    id: "creacion-formularios",
    image: "/img/blog/hero-crm-vertical.webp",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 2h6"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>`,
    title: "Sistemas de Captura de Datos",
    subtitle: "Orden absoluto desde el primer clic",
    description: "Formularios inteligentes que validan la información antes de guardarla. Olvídate de datos mal escritos, campos vacíos o formatos incorrectos.",
    whenToUse: "Si la información que te llega de clientes o empleados es un caos y pierdes tiempo corrigiéndola antes de trabajar.",
    benefits: [
      "Lógica condicional (preguntas dinámicas)",
      "Carga de archivos y fotos integrada",
      "Firmas digitales en el propio formulario",
      "Validación de NIF/CIF, emails y teléfonos",
      "Notificaciones push automáticas al recibir datos"
    ],
    price: "desde 400€",
    priceNote: "pago único · 0€/mes después",
    need: "Automatizar Google Sheets / AppScript",
  },
  {
    id: "formularios-leads-magnet",
    image: "/img/servicios/leads.webp",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    title: "Sistemas Lead Magnet & Captación",
    subtitle: "Tu web vendiendo por ti 24/7",
    description: "Diseñamos el embudo técnico para tus campañas. Formularios que no solo captan, sino que segmentan y califican al cliente automáticamente en tu CRM.",
    whenToUse: "Si haces Ads o tienes tráfico en la web pero no conviertes, o si los leads se quedan 'en el limbo' sin seguimiento inmediato.",
    benefits: [
      "Landing pages de alta conversión incluidas",
      "Auto-respuestas personalizadas al instante",
      "Asignación inteligente de leads al equipo",
      "Trackeo de procedencia (Google/Facebook/RRSS)",
      "Cálculo de ROI por lead integrado"
    ],
    price: "desde 800€",
    priceNote: "pago único · 0€/mes después",
    need: "CRM a medida",
  },
  {
    id: "dashboards-tiempo-real",
    image: "/img/servicios/dashboards.webp",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>`,
    title: "Dashboards y BI en Tiempo Real",
    subtitle: "Visibilidad total para decisiones inteligentes",
    description: "Convertimos tus datos en paneles visuales impactantes. Controla tus ventas, stock o márgenes con un solo vistazo desde tu móvil.",
    whenToUse: "Cuando sientes que no tienes el control de los números o dependes de que alguien te envíe un Excel a final de mes para saber qué pasa.",
    benefits: [
      "Visualización en Looker Studio o Custom Dashboard",
      "Filtros avanzados por fecha, comercial o producto",
      "Predicción de tendencias basada en histórico",
      "Acceso compartido y seguro para socios",
      "Alertas automáticas de KPIs críticos"
    ],
    price: "desde 600€",
    priceNote: "pago único · 0€/mes después",
    need: "Automatizar Google Sheets / AppScript",
  }
];

const groups = [
  { id: 'nube', label: 'Opción 1 · Nuevo', title: 'Sistemas en la nube', intro: 'Servidor y base de datos propios para sistemas que tienen que crecer, abrirse a tus clientes o conectarse con todo.', services: cloudServices },
  { id: 'google', label: 'Opción 2 · 0€/mes', title: 'Sistemas sobre Google Workspace', intro: 'Nuestra especialidad de origen: aplicaciones y automatizaciones dentro de tu Google, con pago único y sin cuotas.', services: googleServices },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Servicios de desarrollo de software de Konte',
  url: `${SITE.url}/servicios/`,
  itemListElement: [...cloudServices, ...googleServices].map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.title, description: s.description, provider: { '@id': `${SITE.url}/#organization` } },
  })),
});
---

<Layout
  ogImage="/img/og/servicios.png"
  title="Servicios de desarrollo de software a medida, nube y Google | Konte"
  description="Sistemas de gestión en la nube, apps móviles, integraciones con WhatsApp y APIs, automatización con Google Sheets y AppScript, dashboards y formularios. Presupuesto en 48 h."
  jsonLd={jsonLd}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative pt-10 pb-16 md:pb-20 bg-white border-b border-gray-200 overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:64px_64px] opacity-30 pointer-events-none"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <Breadcrumbs items={[{ name: 'Servicios', href: '/servicios/' }]} />
      <div class="text-center mt-8">
        <div class="inline-block px-4 py-2 bg-gray-900 text-white font-bold text-xs uppercase tracking-widest mb-6">Todos los servicios</div>
        <h1 class="font-display text-5xl md:text-7xl font-black uppercase tracking-tight mb-6 leading-[0.85] text-gray-900">
          Digitaliza tu operativa.<br/>
          <span class="text-lightAccent">Sin límites.</span>
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed font-medium mb-10">
          Desde un Google Sheets que vuela hasta una plataforma en la nube con app móvil. Elegimos contigo la tecnología que mejor encaja con tu negocio y tu presupuesto.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#contacto" class="group inline-flex items-center justify-center gap-3 px-10 py-5 bg-lightAccent text-white font-black text-base uppercase tracking-widest rounded-sm hover:-translate-y-1 transition-all shadow-[6px_6px_0_0_rgba(0,0,0,0.15)]">
            Pedir presupuesto gratis →
          </a>
          <a href="/soluciones/" class="group inline-flex items-center justify-center gap-3 px-10 py-5 bg-white text-gray-900 font-black text-base uppercase tracking-widest rounded-sm border-2 border-gray-900 hover:-translate-y-1 transition-all shadow-[6px_6px_0_0_rgba(0,0,0,0.15)] hover:border-lightAccent hover:text-lightAccent">
            Ver soluciones por tipo →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES LIST ===================== -->
  {groups.map((group, gi) => (
    <section id={group.id} class={`py-16 md:py-20 ${gi === 0 ? 'bg-white' : 'bg-gray-50 border-t border-gray-200'}`}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10 md:mb-14 max-w-3xl">
          <span class="inline-block px-3 py-1 bg-lightAccent text-white text-[10px] font-black uppercase tracking-widest rounded mb-4">{group.label}</span>
          <h2 class="font-display text-4xl md:text-5xl font-black uppercase text-gray-900 leading-tight mb-3">{group.title}</h2>
          <p class="text-lg text-gray-600 font-medium">{group.intro}</p>
        </div>

        <div class="flex flex-wrap gap-3 mb-12">
          {group.services.map(s => (
            <a href={`#${s.id}`} class="px-4 py-2 bg-gray-100 hover:bg-lightAccent hover:text-white text-gray-700 font-bold text-xs uppercase tracking-widest rounded-full transition-all">
              {s.title}
            </a>
          ))}
        </div>

        <div class="grid grid-cols-1 gap-10">
          {group.services.map((service, i) => (
            <article id={service.id} class="flex flex-col lg:flex-row border-2 border-gray-100 rounded-3xl overflow-hidden hover:border-lightAccent transition-all duration-500 hover:shadow-2xl group/card bg-white">
              <div class="flex-1 p-8 md:p-14 bg-gray-900 relative overflow-hidden">
                <div class="absolute inset-y-0 right-0 w-2/5 pointer-events-none select-none opacity-30">
                  <img src={service.image} alt="" aria-hidden="true" loading="lazy" decoding="async" class="w-full h-full object-cover object-center" />
                  <div class="absolute inset-0" style="background: linear-gradient(to right, #111827 0%, rgba(17,24,39,0.85) 40%, rgba(17,24,39,0.3) 75%, transparent 100%);"></div>
                </div>
                <div class="relative z-10">
                  <div class="flex items-start justify-between mb-8">
                    <div class="w-20 h-20 text-lightAccent bg-lightAccent/10 p-4 rounded-2xl border border-lightAccent/20 group-hover/card:scale-110 transition-transform duration-500" set:html={service.icon} />
                    <span class="text-6xl font-black text-white opacity-10 font-display">0{i + 1}</span>
                  </div>
                  <h3 class="font-display text-3xl md:text-4xl font-black uppercase tracking-tight mb-3 text-white leading-tight">{service.title}</h3>
                  <p class="text-lightAccent font-black text-sm uppercase tracking-widest mb-6">{service.subtitle}</p>
                  <p class="text-xl text-gray-300 leading-relaxed mb-10 font-medium">{service.description}</p>
                  <div class="p-8 bg-white/5 border-l-4 border-lightAccent rounded-r-2xl shadow-sm">
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-lightAccent mb-3">¿Cuándo necesito este servicio?</p>
                    <p class="text-white font-bold text-lg leading-relaxed">"{service.whenToUse}"</p>
                  </div>
                </div>
              </div>

              <div class="w-full lg:w-[420px] p-8 md:p-14 bg-gray-50 border-t lg:border-t-0 lg:border-l border-gray-200 flex flex-col justify-between">
                <div>
                  <h4 class="text-xs font-black uppercase tracking-widest text-gray-400 mb-8 border-b border-gray-200 pb-4">¿Qué incluye?</h4>
                  <ul class="space-y-5">
                    {service.benefits.map(b => (
                      <li class="flex items-start gap-4">
                        <div class="w-6 h-6 bg-lightAccent/10 text-lightAccent rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <span class="text-base font-bold text-gray-700 leading-tight">{b}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="mt-10">
                  <div class="mb-4 px-4 py-3 bg-blue-50 border border-blue-200 rounded-lg text-center">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-500">Inversión</span>
                    <div class="text-2xl font-black text-lightAccent mt-1">{service.price}</div>
                    <span class="text-xs text-gray-500 font-medium">{service.priceNote}</span>
                  </div>
                  <a href="#contacto" data-need={service.need} class="group flex items-center justify-between w-full p-5 bg-gray-900 text-white font-black text-sm uppercase tracking-widest transition-all hover:bg-lightAccent rounded-lg">
                    Pedir presupuesto
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- ===================== NUBE O GOOGLE ===================== -->
  <section class="py-16 md:py-24 bg-white border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <TwoWays heading="¿Nube o Google Workspace? Te ayudamos a decidir" />
    </div>
  </section>
</Layout>
