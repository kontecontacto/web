---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { SITE } from '../../data/site';
import { TRIAL_DAYS } from '../../tools/license';

const APP = '/turnero-online-gratis/app/';

const steps = [
  { t: 'Abre el turnero', d: 'En el ordenador del mostrador, desde Chrome, Edge o Safari. Sin descargar nada y sin registrarte.' },
  { t: 'Saca la pantalla a la TV', d: 'Pulsa «Abrir pantalla», arrastra esa ventana a la TV o al segundo monitor (conectado por HDMI) y pulsa F11.' },
  { t: 'Pulsa «Siguiente»', d: 'Con el ratón, la barra espaciadora o un mando de presentaciones. La TV muestra el número y lo anuncia por voz.' },
];

const features = [
  { t: 'Pantalla para la TV', d: 'Número en grande, puesto al que acudir, últimos turnos llamados, hora y un mensaje que pasa por abajo.' },
  { t: 'Aviso por voz y sonido', d: '«Turno A 23, mostrador 2». Puedes cambiar la frase o quitar la voz y dejar solo el ding-dong.' },
  { t: 'Varias colas y puestos', d: 'Hasta 3 colas con su letra (A carnicería, B charcutería…) y todos los mostradores que necesites.' },
  { t: 'Tickets impresos', d: 'Opcional: da número al cliente e imprime su ticket en una impresora térmica de 80 mm.' },
  { t: 'Rápido de usar', d: 'Atajos de teclado y compatible con mandos de presentaciones para llamar sin mirar la pantalla.' },
  { t: 'Funciona sin internet', d: 'Se instala como una app en el ordenador. Si se cae la conexión, el turnero sigue funcionando.' },
];

const sectors = ['Carnicerías y charcuterías', 'Pescaderías', 'Panaderías y pastelerías', 'Farmacias', 'Clínicas y laboratorios', 'Ópticas', 'Talleres', 'Tiendas de telefonía', 'Mercados municipales', 'Administraciones y gestorías', 'Oficinas de atención al público', 'Delicatessen y queserías'];

const compare: [string, string, string][] = [
  ['Pantalla de turnos con voz y sonido', '✓', '✓'],
  ['Colas', 'Hasta 3', 'Ilimitadas'],
  ['Puestos / mostradores', '✓', '✓'],
  ['Tickets impresos', '✓', '✓ + botón o dispensador'],
  ['Llamar desde el móvil o desde otro ordenador', '—', '✓'],
  ['El cliente saca turno con un QR en su móvil', '—', '✓'],
  ['Aviso por WhatsApp cuando le toca', '—', '✓'],
  ['Cita previa online en la misma pantalla', '—', '✓'],
  ['Tu logo y tus colores, sin marca Konte', '—', '✓'],
  ['Estadísticas de espera y atención', 'Básicas', 'Completas'],
  ['Precio', 'Gratis*', 'Presupuesto a medida'],
];

const faqs = [
  { q: '¿El turnero es gratis de verdad?', a: `Sí. Puedes usarlo libremente durante ${TRIAL_DAYS} días sin registrarte, y después seguir usándolo gratis con un registro sencillo (nombre, email y negocio). No pedimos tarjeta.` },
  { q: '¿Tengo que instalar algo?', a: 'No. Funciona en el navegador (Chrome, Edge o Safari). Si quieres, puedes instalarlo como app con el botón «Instalar app» para abrirlo con un clic y usarlo sin conexión.' },
  { q: '¿Cómo lo pongo en la televisión?', a: 'Conecta la TV al ordenador por HDMI como segunda pantalla, abre la pantalla de turnos desde el panel, arrastra esa ventana a la TV y pulsa F11 para verla a pantalla completa.' },
  { q: '¿Puedo llamar los turnos desde el móvil y que la TV cambie sola?', a: 'En la versión gratuita el panel y la pantalla funcionan en el mismo ordenador. Para llamar desde el móvil, la tableta u otro ordenador necesitas la versión Pro, que funciona con nuestro servidor.' },
  { q: '¿Puedo imprimir tickets con el número?', a: 'Sí. Activa «Dar números e imprimir tickets» en Ajustes y cada vez que des un número se imprimirá el ticket. Funciona con impresoras térmicas de 80 mm y con impresoras normales.' },
  { q: '¿Dónde se guardan mis datos?', a: 'En tu propio navegador. El turnero no envía a ningún sitio los turnos que llamas. Solo nos llegan los datos que nos das si te registras.' },
  { q: `¿Qué pasa después de los ${TRIAL_DAYS} días?`, a: 'El turnero te pide un registro gratuito para seguir funcionando. Una vez registrado no te lo vuelve a pedir.' },
  { q: '¿Sirve como sistema de turnos para mi clínica o administración?', a: 'Sí, para ordenar la sala de espera. Si además quieres cita previa online, recordatorios o turnos por WhatsApp, lo desarrollamos a medida en la versión Pro.' },
];

const appJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Turnero online gratis de Konte',
  url: `${SITE.url}/turnero-online-gratis/`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Navegador web (Chrome, Edge, Safari)',
  description: 'Turnero online gratis con pantalla de turnos para TV, aviso por voz, varias colas y tickets impresos. Sin instalar y sin registro.',
  image: `${SITE.url}/img/og/turnero-online-gratis.png`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  inLanguage: 'es',
  publisher: { '@id': `${SITE.url}/#organization` },
});
---

<Layout
  title="Turnero online gratis: pantalla de turnos con voz | Konte"
  description="Turnero online gratis para tu negocio: pantalla de turnos para la TV, aviso por voz, varias colas y tickets impresos. Sin instalar nada y sin registro. Empieza en 1 minuto."
  ogImage="/img/og/turnero-online-gratis.png"
  jsonLd={appJsonLd}
  contactProps={{ need: 'Sistema de turnos / citas / reservas', title: '¿Quieres el turnero Pro?', subtitle: 'Turnos desde el móvil, QR para tus clientes, avisos por WhatsApp y cita previa online, con tu marca. Te lo adaptamos y lo instalamos.' }}
>
  <section class="relative bg-white border-b border-gray-200 overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:64px_64px] opacity-30 pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16 md:pt-16 md:pb-24 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <Breadcrumbs items={[{ name: 'Herramientas gratis', href: '/herramientas-gratis/' }, { name: 'Turnero online gratis', href: '/turnero-online-gratis/' }]} />
        <div class="mt-6 inline-flex items-center gap-2 px-3 py-1.5 bg-green-50 border border-green-200 text-green-700 rounded-full">
          <span class="text-xs font-black uppercase tracking-widest">Gratis · sin instalar · sin registro</span>
        </div>
        <h1 class="mt-5 font-display text-4xl md:text-6xl font-black uppercase tracking-tight leading-[0.95] text-gray-900">
          Turnero online <span class="text-lightAccent">gratis</span> con pantalla y aviso por voz
        </h1>
        <p class="mt-6 text-lg md:text-xl text-gray-600 leading-relaxed font-medium">
          Ordena la cola de tu negocio en un minuto. Llamas al siguiente con un clic y tu TV muestra y anuncia el turno. Se acabó el «¿quién va ahora?».
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={APP} data-tool-open class="inline-flex items-center justify-center gap-3 px-8 py-5 bg-green-500 hover:bg-green-600 text-white font-black text-lg uppercase tracking-wide rounded-sm shadow-[6px_6px_0_0_rgba(0,0,0,0.15)] hover:-translate-y-0.5 transition">
            Abrir el turnero gratis →
          </a>
          <a href="#como-funciona" class="inline-flex items-center justify-center px-8 py-5 border-2 border-gray-900 text-gray-900 font-black uppercase tracking-wide rounded-sm hover:border-lightAccent hover:text-lightAccent transition-colors">Cómo funciona</a>
        </div>
        <p class="mt-4 text-sm text-gray-500">Funciona en Chrome, Edge y Safari. Se instala como app y funciona sin internet.</p>

        <div class="lg:hidden mt-8 p-5 bg-blue-50 border-2 border-blue-100 rounded-2xl" data-form-wrap>
          <form data-konte-form data-subject="Turnero gratis: enlace enviado al móvil" novalidate>
            <p class="font-black text-gray-900 mb-1">¿Estás en el móvil?</p>
            <p class="text-sm text-gray-600 mb-3">El turnero se usa en el ordenador de tu negocio. Te enviamos el enlace por email para abrirlo allí.</p>
            <input type="hidden" name="origen" value="Turnero gratis (móvil)" />
            <input type="hidden" name="_autoresponse" value={`Aquí tienes tu turnero gratis. Ábrelo en el ordenador de tu negocio: ${SITE.url}${APP}\n\nPulsa «Abrir pantalla», lleva esa ventana a la TV y pulsa F11. Después, «Siguiente» para llamar cada turno.\n\n¿Quieres llamar desde el móvil, que tus clientes saquen turno con un QR o recibir avisos por WhatsApp? Responde a este email o escríbenos al ${SITE.phone}.\n\nKonte · ${SITE.url}`} />
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <div class="flex gap-2">
              <label for="tm-email" class="sr-only">Tu email</label>
              <input id="tm-email" type="email" name="email" required placeholder="tu@email.com" class="flex-1 min-w-0 px-3 py-3 border-2 border-gray-200 rounded-lg text-sm focus:outline-none focus:border-lightAccent" />
              <button type="submit" class="px-4 py-3 bg-lightAccent text-white font-black text-sm rounded-lg whitespace-nowrap"><span data-submit-label>Enviar</span></button>
            </div>
            <p data-form-error-inline class="hidden mt-2 text-sm font-bold text-red-600"></p>
          </form>
          <div data-form-success class="hidden">
            <p class="font-black text-gray-900">¡Enviado! 📩</p>
            <p class="text-sm text-gray-600">Ábrelo desde el email en el ordenador de tu negocio.</p>
            <a data-success-whatsapp href="#" class="hidden"></a>
          </div>
          <div data-form-failure class="hidden">
            <p class="text-sm text-gray-600">No se pudo enviar. Copia este enlace y ábrelo en el ordenador: <b>konte.es/turnero-online-gratis</b></p>
            <a data-failure-whatsapp href="#" class="hidden"></a><a data-failure-email href="#" class="hidden"></a>
          </div>
        </div>
      </div>
      <div class="relative">
        <div class="bg-gray-900 rounded-[22px] p-3 shadow-2xl">
          <img src="/img/turnero/pantalla.webp" alt="Pantalla del turnero online gratis con el turno A07 llamado al mostrador 2" width="1280" height="720" class="w-full h-auto rounded-xl" />
        </div>
        <div class="mx-auto w-24 h-6 bg-gray-800 rounded-b-xl"></div>
        <div class="absolute -bottom-10 -right-2 md:-right-6 w-44 md:w-60 bg-white rounded-xl border border-gray-200 shadow-2xl overflow-hidden rotate-2">
          <img src="/img/turnero/panel.webp" alt="Panel de control del turnero con el botón Siguiente" width="800" height="538" loading="lazy" class="w-full h-auto" />
        </div>
      </div>
    </div>
  </section>

  <section id="como-funciona" class="py-16 md:py-24 bg-gray-50 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl md:text-5xl font-black uppercase text-gray-900 text-center mb-12">Funcionando en 3 pasos</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {steps.map((s, i) => (
          <div class="p-7 bg-white border-2 border-gray-200 rounded-2xl">
            <div class="w-12 h-12 rounded-full bg-lightAccent text-white font-display font-black text-xl flex items-center justify-center mb-5">{i + 1}</div>
            <h3 class="font-display text-xl font-black uppercase text-gray-900 mb-2">{s.t}</h3>
            <p class="text-gray-600 leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href={APP} data-tool-open class="inline-flex items-center gap-3 px-8 py-4 bg-green-500 hover:bg-green-600 text-white font-black uppercase tracking-widest rounded-sm shadow-[4px_4px_0_0_rgba(0,0,0,0.15)]">Probarlo ahora</a>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl md:text-5xl font-black uppercase text-gray-900 mb-10 leading-tight">Todo lo que necesita un sistema de turnos</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {features.map((f) => (
          <div class="p-6 border-2 border-gray-200 rounded-2xl hover:border-lightAccent transition-colors">
            <h3 class="font-display text-lg font-black uppercase text-gray-900 mb-2">{f.t}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{f.d}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 p-8 bg-gray-50 border border-gray-200 rounded-2xl">
        <h2 class="font-display text-xl font-black uppercase text-gray-900 mb-4">Pensado para</h2>
        <div class="flex flex-wrap gap-2">
          {sectors.map((s) => <span class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-bold text-gray-700">{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50 border-y border-gray-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl md:text-5xl font-black uppercase text-gray-900 text-center mb-4">Gratis o Pro</h2>
      <p class="text-center text-lg text-gray-600 mb-10 font-medium">Empieza gratis. Cuando necesites más, lo hacemos a medida para tu negocio.</p>
      <div class="overflow-x-auto bg-white border-2 border-gray-900 rounded-2xl">
        <table class="w-full text-sm min-w-[560px]">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="text-left p-4 font-black uppercase tracking-wide">Función</th>
              <th class="p-4 font-black uppercase tracking-wide">Gratis</th>
              <th class="p-4 font-black uppercase tracking-wide bg-lightAccent">Pro</th>
            </tr>
          </thead>
          <tbody>
            {compare.map(([f, free, pro]) => (
              <tr class="border-t border-gray-100">
                <td class="p-4 font-bold text-gray-800">{f}</td>
                <td class="p-4 text-center text-gray-600">{free}</td>
                <td class="p-4 text-center font-bold text-lightAccent bg-blue-50/50">{pro}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-gray-500">* Uso libre durante {TRIAL_DAYS} días; después, registro gratuito para seguir usándolo.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={APP} data-tool-open class="inline-flex items-center justify-center px-8 py-4 bg-green-500 hover:bg-green-600 text-white font-black uppercase tracking-widest rounded-sm">Empezar gratis</a>
        <a href="#contacto" data-need="Sistema de turnos / citas / reservas" class="inline-flex items-center justify-center px-8 py-4 bg-lightAccent text-white font-black uppercase tracking-widest rounded-sm">Pedir la versión Pro</a>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl md:text-5xl font-black uppercase text-gray-900 text-center mb-12">Preguntas frecuentes</h2>
      <Faq items={faqs} />
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('[data-tool-open]').forEach((a) =>
    a.addEventListener('click', () => (window as any).gtag?.('event', 'tool_open', { tool: 'turnero' }))
  );
</script>
