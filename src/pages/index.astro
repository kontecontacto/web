            <p data-form-error-inline class="hidden mt-3 text-sm font-bold text-red-400"></p>
          </form>
          <div data-form-success class="hidden">
            <a href="https://script.google.com/macros/s/AKfycbxuWkpv-4lN_CGTRu7py0q3qk-fEA9ENtBMUTzAgJ7gYxTVGIE-VRmke7y64IfyBtYwmA/exec" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-10 py-5 bg-lightAccent text-white font-black text-lg uppercase tracking-widest rounded-sm hover:-translate-y-1 transition-all">
              Abrir la demo →
            </a>
          </div>
          <div data-form-failure class="hidden">
            <a href="https://script.google.com/macros/s/AKfycbxuWkpv-4lN_CGTRu7py0q3qk-fEA9ENtBMUTzAgJ7gYxTVGIE-VRmke7y64IfyBtYwmA/exec" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-10 py-5 bg-lightAccent text-white font-black text-lg uppercase tracking-widest rounded-sm">
