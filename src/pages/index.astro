---
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import Layout from '../layouts/Layout.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.jsx';
import ProjectGallery from '../components/ProjectGallery.jsx';
import SolutionCards from '../components/SolutionCards.astro';
import TwoWays from '../components/TwoWays.astro';
import Process from '../components/Process.astro';
import CrmTemplateBand from '../components/CrmTemplateBand.astro';
import Faq from '../components/Faq.astro';
import { PROJECTS } from '../data/projects';
import { SITE, whatsappLink } from '../data/site';

const testimonials = [
  {
    quote: "Pasamos de gestionar 5 cafeterías con hojas de Excel rotas a tener visibilidad total en tiempo real. El sistema no falló ni un día.",
    author: "Responsable de Operaciones",
    company: "FlagShip Cafeterías",
    sector: "Gastronomía · USA"
  },
  {
    quote: "Antes perdíamos lotes enteros por falta de control. Ahora cualquier operario sabe exactamente qué hay en cámara y cuándo vence. Es otra empresa.",
    author: "Director de Producción",
    company: "Montelimar",
    sector: "Manufactura"
  },
  {
    quote: "En 3 semanas teníamos el inventario de piezas completamente digitalizado. El equipo tardó 1 hora en aprender a usarlo.",
    author: "Gerente de Taller",
    company: "Recomotor",
    sector: "Autopartes"
  },
  {
    quote: "El dashboard me ahorra 2 horas al día. Puedo ver el ROI de cada obra desde el móvil. Fue la mejor inversión del año.",
    author: "Director Financiero",
    company: "Constructoras — Gestor Financiero",
    sector: "Construcción"
  }
];

const heroNeeds = [
  ['CRM', 'CRM a medida'],
  ['Turnos y citas', 'Sistema de turnos / citas / reservas'],
  ['Tickets con QR', 'Tickets o entradas con QR'],
  ['Inventario', 'Inventario y stock con escáner'],
  ['ERP / gestión', 'ERP / programa de gestión'],
  ['Fichaje', 'Control horario / fichaje'],
  ['App a medida', 'App móvil o plataforma web'],
  ['Otra idea', 'Otra cosa / no lo tengo claro'],
];

const reasons = [
  { t: 'Hablas con quien programa', d: 'Sin comerciales ni intermediarios. La persona que te escucha es la que construye tu sistema.' },
  { t: 'Precio cerrado', d: 'Sabes lo que vas a pagar antes de empezar. Sin horas extra sorpresa.' },
  { t: 'Tus datos son tuyos', d: 'Puedes exportarlos cuando quieras. Sin permanencias ni dependencias raras.' },
  { t: 'Demos cada semana', d: 'Ves el avance real desde la primera semana y corregimos el rumbo contigo.' },
];

const faqs = [
  { q: '¿Qué tipo de software desarrolláis?', a: 'Cualquier sistema de gestión que una empresa necesite: CRM, sistemas de turnos y cita previa, tickets y entradas con QR, sistemas de tickets de soporte, control de inventario con escáner, ERP, control horario y fichaje, control de producción y trazabilidad, apps para gimnasios y entrenadores, portales de clientes y automatizaciones con Google Sheets y Apps Script.' },
  { q: '¿Cuánto cuesta un software a medida?', a: 'Depende del alcance. Sobre Google Workspace es un pago único: desde unos 300€ las mejoras de hojas de cálculo y entre 2.500€ y 8.000€ las aplicaciones completas, sin cuota mensual. En la nube, es un pago único por el desarrollo más una cuota mensual por servidor y mantenimiento, según el proyecto. En ambos casos te damos un presupuesto cerrado en 48 h.' },
  { q: '¿Qué diferencia hay entre la opción en la nube y la de Google Workspace?', a: 'La opción en la nube tiene servidor y base de datos propios: es la adecuada si hay muchos usuarios, clientes que acceden desde fuera, pagos online, app móvil o integraciones. La de Google Workspace funciona dentro de tu cuenta de Google, es más rápida de construir y no tiene cuota mensual. Te recomendamos la que tiene sentido para tu caso.' },
  { q: '¿Cuánto se tarda en tener el sistema funcionando?', a: 'Las automatizaciones sencillas pueden estar listas en 1 o 2 semanas. Las aplicaciones completas, entre 4 y 8 semanas para la primera versión, según la complejidad. Trabajamos por fases para que empieces a usarlo cuanto antes.' },
  { q: '¿Trabajáis con empresas fuera de Barcelona?', a: 'Sí. Estamos en Barcelona y trabajamos en remoto con empresas de toda España y de Latinoamérica: México, Argentina, Colombia, Chile, Perú, Uruguay y otros países. Las reuniones son por videollamada y el soporte, por WhatsApp y email.' },
  { q: '¿De quién son el código y los datos?', a: 'Los datos son siempre tuyos y puedes exportarlos cuando quieras. En los proyectos sobre Google Workspace el sistema vive en tu propia cuenta; en la nube, la propiedad del código se define en el contrato.' },
  { q: '¿Ofrecéis soporte y mantenimiento?', a: 'Sí. En la opción en la nube, el servidor, las copias de seguridad, las actualizaciones de seguridad y el soporte van incluidos en la cuota mensual. En la de Google Workspace no hay cuota: nos avisas cuando necesites un cambio o una mejora.' },
  { q: '¿Funciona si ya tenemos muchos datos en Excel?', a: 'Sí. Migramos tus datos desde Excel, Google Sheets u otro programa como parte del proyecto, y limpiamos duplicados y errores por el camino.' },
];
---

<Layout
  title="Software a medida para empresas: CRM, turnos, tickets y ERP | Konte"
  description="Desarrollamos el software que tu empresa necesita: CRM, turnos y citas, tickets con QR, inventario, ERP y apps. Desde Barcelona para España y Latinoamérica."
>
  <!-- ===================== HERO ===================== -->
  <section class="relative bg-white overflow-hidden border-b border-gray-200">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:64px_64px] opacity-40 pointer-events-none"></div>
    <div class="absolute top-0 right-0 w-[700px] h-[500px] bg-lightAccent/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20 grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
      <div>
        <div class="inline-flex items-center gap-3 bg-blue-50 border border-blue-200 rounded-full px-4 py-1.5 mb-7">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-lightAccent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-lightAccent"></span>
          </span>
          <span class="text-xs sm:text-sm font-bold text-lightAccent uppercase tracking-wider">+100 proyectos entregados · {SITE.city}</span>
        </div>

        <h1 class="font-display font-black uppercase tracking-tighter text-gray-900 leading-[0.9] mb-6">
          <span class="block text-5xl sm:text-6xl lg:text-7xl">Software</span>
          <span class="block text-5xl sm:text-6xl lg:text-7xl text-lightAccent">a medida</span>
          <span class="block text-3xl sm:text-4xl lg:text-5xl mt-2">para tu empresa.</span>
        </h1>

        <p class="text-lg md:text-xl text-gray-600 mb-8 max-w-2xl font-medium leading-relaxed">
          <strong class="text-gray-900">CRM, sistemas de turnos y citas, tickets con QR, inventario, ERP, fichaje…</strong> Si tu negocio lo necesita, lo desarrollamos. En la nube con servidor propio o sobre Google Workspace sin cuotas.
        </p>

        <p class="text-xs font-black uppercase tracking-widest text-gray-500 mb-3">¿Qué quieres construir?</p>
        <div class="flex flex-wrap gap-2 mb-9">
          {heroNeeds.map(([labelText, need]) => (
            <a href="#contacto" data-need={need} class="px-4 py-2 bg-white border-2 border-gray-200 hover:border-lightAccent hover:text-lightAccent text-gray-800 font-bold text-sm rounded-full transition-colors">{labelText}</a>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-3 mb-5">
          <a href="#contacto" class="group inline-flex items-center justify-center gap-3 px-8 py-4 bg-lightAccent text-white font-black text-base uppercase tracking-wide rounded-sm hover:-translate-y-1 transition-all shadow-[6px_6px_0_0_rgba(0,0,0,0.15)] hover:shadow-[2px_2px_0_0_rgba(0,0,0,0.15)]">
            Pedir presupuesto gratis
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#25D366] hover:bg-[#128C7E] text-white font-black text-base uppercase tracking-wide rounded-sm hover:-translate-y-1 transition-all shadow-[6px_6px_0_0_rgba(37,211,102,0.25)]">
            <WhatsAppIcon class="w-5 h-5" />
            WhatsApp
          </a>
        </div>
        <p class="text-sm text-gray-500 font-medium">
          O llámanos: <a href={SITE.phoneHref} class="font-bold text-gray-900 hover:text-lightAccent">{SITE.phone}</a> · Respuesta en menos de 24 h
        </p>
      </div>

      <!-- Composición visual: ejemplos de sistemas -->
      <div class="relative hidden lg:block h-[520px]" aria-hidden="true">
        <div class="absolute top-6 left-0 right-10 bg-white rounded-2xl border border-gray-200 shadow-2xl overflow-hidden">
          <div class="h-8 bg-gray-100 border-b border-gray-200 flex items-center gap-1.5 px-4">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span><span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span><span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
            <span class="ml-3 text-[10px] font-bold text-gray-400">tuempresa.konte.app/crm</span>
          </div>
          <div class="p-5 grid grid-cols-3 gap-3">
            <div class="col-span-3 flex items-center justify-between mb-1">
              <p class="font-display font-black uppercase text-gray-900">Embudo de ventas</p>
              <span class="text-[10px] font-black text-green-600 bg-green-50 px-2 py-1 rounded">+18% este mes</span>
            </div>
            {[['Nuevos', '12', 'bg-gray-100'], ['Propuesta', '7', 'bg-blue-50'], ['Ganados', '5', 'bg-green-50']].map(([t, n, bg]) => (
              <div class={`${bg} rounded-xl p-3`}>
                <p class="text-[10px] font-black uppercase tracking-widest text-gray-500">{t}</p>
                <p class="font-display text-3xl font-black text-gray-900">{n}</p>
                <div class="mt-2 space-y-1.5">
                  <div class="h-2 bg-white rounded"></div>
                  <div class="h-2 bg-white rounded w-3/4"></div>
                </div>
              </div>
            ))}
            <div class="col-span-3 h-24 rounded-xl bg-gradient-to-t from-blue-50 to-white border border-gray-100 flex items-end gap-2 p-3">
              {[30, 45, 38, 60, 52, 74, 68, 90].map((h) => <div class="flex-1 bg-lightAccent/80 rounded-t" style={`height:${h}%`}></div>)}
            </div>
          </div>
        </div>

        <div class="absolute bottom-0 right-0 w-56 bg-gray-900 rounded-[28px] p-3 shadow-2xl rotate-3">
          <div class="bg-white rounded-[20px] p-4 text-center">
            <p class="text-[10px] font-black uppercase tracking-widest text-gray-400">Entrada · Fila 4</p>
            <p class="font-display font-black text-gray-900 uppercase mb-3">Concierto Gràcia</p>
            <div class="mx-auto w-28 h-28 grid grid-cols-7 gap-0.5 p-1.5 bg-white border-2 border-gray-900 rounded">
              {Array.from({ length: 49 }).map((_, i) => <span class={(i * 7 + (i % 5) * 3) % 3 === 0 || [0,1,2,7,9,14,15,16,4,5,6,11,13,18,19,20,28,29,30,35,37,42,43,44].includes(i) ? 'bg-gray-900' : 'bg-white'}></span>)}
            </div>
            <p class="mt-3 text-xs font-black text-green-600 flex items-center justify-center gap-1">✓ Válida · escaneada 21:04</p>
          </div>
        </div>

        <div class="absolute bottom-6 left-0 bg-white rounded-xl border border-gray-200 shadow-xl p-4 w-64 -rotate-2">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-lg bg-lightAccent text-white flex items-center justify-center font-black">10:30</span>
            <div>
              <p class="text-sm font-black text-gray-900">Cita confirmada</p>
              <p class="text-xs text-gray-500">Fisioterapia · Sala 2 · Laura</p>
            </div>
          </div>
          <p class="mt-3 text-[11px] font-bold text-gray-500 bg-gray-50 rounded px-2 py-1.5">📲 Recordatorio enviado por WhatsApp</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="bg-gray-900 py-12 border-b border-gray-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="font-display text-4xl md:text-5xl font-black text-lightAccent mb-2">+100</div>
        <div class="text-xs font-black uppercase tracking-widest text-gray-400">Proyectos entregados</div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl font-black text-white mb-2">48 h</div>
        <div class="text-xs font-black uppercase tracking-widest text-gray-400">Para tu propuesta cerrada</div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl font-black text-lightAccent mb-2">0€/mes</div>
        <div class="text-xs font-black uppercase tracking-widest text-gray-400">Opción Google Workspace</div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl font-black text-white mb-2">BCN</div>
        <div class="text-xs font-black uppercase tracking-widest text-gray-400">España y Latinoamérica</div>
      </div>
    </div>
  </section>

  <!-- ===================== SOLUCIONES ===================== -->
  <section id="soluciones" class="py-20 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-block px-4 py-2 bg-gray-900 text-white font-bold text-xs uppercase tracking-widest mb-6">Lo que desarrollamos</div>
        <h2 class="font-display text-4xl md:text-6xl font-black uppercase mb-5 leading-tight text-gray-900">
          El sistema que necesitas,<br/><span class="text-lightAccent">hecho para tu negocio</span>
        </h2>
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto font-medium">Nada de adaptar tu empresa a un programa genérico. Construimos la herramienta alrededor de cómo trabajas tú.</p>
      </div>
      <SolutionCards />
    </div>
  </section>

  <!-- ===================== DOS OPCIONES ===================== -->
  <section id="modelo" class="py-20 md:py-24 bg-gray-50 border-y border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <TwoWays />
    </div>
  </section>

  <!-- ===================== ANTES / DESPUÉS ===================== -->
  <section id="comparativa" class="w-full py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <BeforeAfterSlider client:visible />
    </div>
  </section>

  <!-- ===================== PROYECTOS ===================== -->
  <section id="proyectos" class="w-full py-20 md:py-24 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-block px-4 py-2 bg-gray-900 text-white font-bold text-xs uppercase tracking-widest mb-6">Portfolio real</div>
        <h2 class="font-display text-4xl md:text-6xl font-black uppercase mb-4 text-gray-900">Casos de éxito</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto font-medium">Empresas reales. Problemas reales. Sistemas que siguen funcionando hoy.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 w-full">
        {PROJECTS.map((proj) => (
          <div class="bg-white p-6 lg:p-8 border border-gray-200 rounded-2xl overflow-hidden hover:border-lightAccent transition-all duration-300 hover:-translate-y-1 hover:shadow-xl flex flex-col h-full group/card">
            <div class="flex flex-wrap gap-2 mb-5">
              {proj.tags.map(tag => (
                <span class="px-3 py-1.5 bg-blue-50 text-blue-700 text-[10px] font-bold uppercase tracking-widest rounded-md border border-blue-100">{tag}</span>
              ))}
            </div>
            <div class="mb-4">
              <img
                src={encodeURI(`/img/${proj.folder}/${proj.logo}`)}
                alt={`Logo ${proj.title}`}
                loading="lazy"
                class={`h-10 md:h-12 w-auto object-contain drop-shadow-sm transition-transform group-hover/card:scale-105 ${proj.id !== 'montelimar' ? 'brightness-0 opacity-85' : ''}`}
              />
            </div>
            <h3 class="font-display text-2xl font-bold mb-3 leading-tight text-gray-900 uppercase tracking-tight">{proj.title}</h3>
            <p class="text-gray-600 mb-6 text-sm leading-relaxed flex-1" set:html={proj.desc}></p>
            <ProjectGallery client:visible project={proj} />
          </div>
        ))}
      </div>

      <div class="mt-16 text-center bg-gray-900 rounded-2xl p-10 md:p-14">
        <p class="text-gray-400 text-sm font-bold uppercase tracking-widest mb-3">¿Tu empresa podría ser el próximo caso de éxito?</p>
        <h3 class="font-display text-3xl md:text-5xl font-black text-white uppercase mb-8">Hablemos de tu proyecto</h3>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#contacto" class="group inline-flex items-center justify-center gap-3 px-10 py-5 bg-lightAccent text-white font-black text-lg uppercase tracking-widest rounded-sm hover:-translate-y-1 transition-all shadow-[6px_6px_0_0_rgba(0,85,255,0.3)]">
            Pedir presupuesto <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <button type="button" data-calendly class="inline-flex items-center justify-center gap-3 px-10 py-5 bg-white/10 border border-white/20 text-white font-black text-lg uppercase tracking-widest rounded-sm hover:bg-white/20 transition-colors">
            Agendar videollamada
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROCESO + POR QUÉ ===================== -->
  <section id="como-trabajamos" class="py-20 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-block px-4 py-2 bg-lightAccent text-white font-bold text-xs uppercase tracking-widest mb-6">Cómo trabajamos</div>
        <h2 class="font-display text-4xl md:text-5xl font-black uppercase text-gray-900 leading-tight">De la idea al sistema funcionando,<br class="hidden md:block" /> sin sorpresas</h2>
      </div>
      <Process />

      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {reasons.map((r) => (
          <div class="flex gap-4">
            <span class="w-8 h-8 flex-shrink-0 rounded-full bg-blue-50 text-lightAccent flex items-center justify-center font-black">✓</span>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">{r.t}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{r.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== TESTIMONIOS ===================== -->
  <section id="testimonios" class="py-20 md:py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-block px-4 py-2 bg-lightAccent text-white font-bold text-xs uppercase tracking-widest mb-6">Testimonios</div>
        <h2 class="font-display text-4xl md:text-5xl font-black uppercase text-gray-900">Lo que dicen nuestros clientes</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {testimonials.map((t, i) => (
          <figure class={`p-8 md:p-10 rounded-2xl border-2 flex flex-col gap-6 ${i % 2 === 0 ? 'bg-gray-900 border-gray-800' : 'bg-white border-gray-200'}`}>
            <div class="flex gap-1" aria-label="5 de 5 estrellas">
              {[1,2,3,4,5].map(() => (
                <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <blockquote class={`text-lg leading-relaxed font-medium italic ${i % 2 === 0 ? 'text-gray-200' : 'text-gray-700'}`}>
              "{t.quote}"
            </blockquote>
            <figcaption class="flex items-center gap-4">
              <div class={`w-12 h-12 rounded-full flex items-center justify-center font-display font-black text-xl ${i % 2 === 0 ? 'bg-lightAccent text-white' : 'bg-gray-900 text-white'}`}>
                {t.author.charAt(0)}
              </div>
              <div>
                <div class={`font-bold text-sm ${i % 2 === 0 ? 'text-white' : 'text-gray-900'}`}>{t.author}</div>
                <div class="text-xs font-bold uppercase tracking-widest text-lightAccent">{t.company}</div>
                <div class={`text-xs ${i % 2 === 0 ? 'text-gray-500' : 'text-gray-400'}`}>{t.sector}</div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CrmTemplateBand />

  <!-- ===================== DEMO ===================== -->
  <section id="demo" class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-gray-900 rounded-2xl p-8 md:p-12 relative overflow-hidden">
        <div class="absolute -top-20 -right-20 w-64 h-64 bg-lightAccent/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative" data-form-wrap>
          <div class="inline-block px-4 py-2 bg-lightAccent text-white font-bold text-xs uppercase tracking-widest mb-6 rounded-full">Demo gratuita</div>
          <h2 class="font-display text-3xl md:text-5xl font-black uppercase mb-4 text-white leading-tight">
            Prueba una app real<br/><span class="text-lightAccent">antes de decidir</span>
          </h2>
          <p class="text-gray-400 text-lg mb-8 max-w-2xl mx-auto">
            Navega por un panel de gestión real hecho por nosotros, con datos de prueba. Sin instalar nada.
          </p>
          <form id="demo-form" data-konte-form data-subject="Acceso a la demo desde konte.es" class="max-w-xl mx-auto" novalidate>
            <input type="hidden" name="origen" value="Demo home" />
