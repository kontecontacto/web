  {
    tags: ['Salud & Fitness', 'Planificador de Rutinas'],
    title: 'App Integral para Entrenadores',
    desc: 'Un <strong>dashboard de seguimiento de clientes</strong> para entrenadores deportivos. Control absoluto y <strong>gestión de pagos recurrentes</strong>, asignación de rutinas personalizadas, centralizando historiales y ahorrando un 80% del tiempo organizativo manual.',
    folder: 'Gestion Gym -Entrenador personal',
    logo: 'logo.png',
    mainImg: '1.png',
    thumbs: ['Captura de pantalla 2026-03-31 181347.png', 'Captura de pantalla 2026-03-31 181353.png', 'Captura de pantalla 2026-03-31 181404.png']
  },  
  {
    tags: ['Agroindustria', 'Gestión de Materia Prima'],
    title: 'Hefe: ERP de Automatización Agrícola',
    desc: 'De caos logístico a control maestro. Los operarios visualizan en piso la <strong>escalabilidad de recetas industriales</strong>, el sistema computa el alta de las <strong>órdenes de producción y stock</strong> automáticamente, actuando como un <strong>ERP a medida</strong> 100% digitalizado.',
    folder: 'Hefe - Planta fertilizantes',
    logo: 'logo.png',
    mainImg: '1.png',
    thumbs: ['Captura de pantalla 2026-03-31 175019.png', 'Captura de pantalla 2026-03-31 175208.png', 'Captura de pantalla 2026-03-31 175213.png']
  },
  {
    tags: ['Construcción', 'Flujo de Caja'],
    title: 'Gestor Financiero Constructoras',
    desc: 'Sistema de alta capacidad para la auditoría y el <strong>control de presupuestos de obra</strong>. Un robusto <strong>dashboard financiero</strong> donde se supervisan gastos de proveedores, flujos de pagos y el índice de <strong>rentabilidad por proyecto</strong>.',
    folder: 'Gestor Financiero Constructoras',
    logo: 'logo.png',
    mainImg: '1.png',
    thumbs: ['Captura de pantalla 2026-03-31 190931.png', 'Captura de pantalla 2026-03-31 190950.png']
  }
];

const testimonials = [
  {
    quote: "Pasamos de gestionar 5 cafeterías con hojas de Excel rotas a tener visibilidad total en tiempo real. El sistema no falló ni un día.",
    author: "Responsable de Operaciones",
    company: "FlagShip Cafeterías",
    sector: "Gastronomía · USA"
  },
  {
    quote: "Antes perdíamos lotes enteros por falta de control. Ahora cualquier operario sabe exactamente qué hay en cámara y cuándo vence. Es otra empresa.",
    author: "Director de Producción",
    company: "Montelimar",
    sector: "Manufactura"
  },
  {
    quote: "En 3 semanas teníamos el inventario de piezas completamente digitalizado. El equipo tardó 1 hora en aprender a usarlo.",
    author: "Gerente de Taller",
    company: "Recomotor",
    sector: "Autopartes"
  },
  {
    quote: "El dashboard me ahorra 2 horas al día. Puedo ver el ROI de cada obra desde el móvil. Fue la mejor inversión del año.",
    author: "Director Financiero",
    company: "Constructoras — Gestor Financiero",
    sector: "Construcción"
  }
];

const services = [
  {
    id: "mejora-hojas-calculo",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 3v18"/><path d="M13 13l2 2 4-4"/></svg>`,
    title: "Optimización Google Sheets",
    shortDesc: "De hojas lentas a sistemas de alto rendimiento sin lag ni errores.",
    color: "blue"
  },
  {
    id: "automatizacion-appscript",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: "Automatización AppScript",
    shortDesc: "Robots internos que trabajan por ti: facturas, alertas, sincronizaciones.",
    color: "indigo"
  },
  {
    id: "software-customizado",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>`,
    title: "Web-Apps a Medida",
    shortDesc: "Apps profesionales con interfaz moderna. Google Sheets como backend.",
    color: "violet"
  },
  {
    id: "dashboards-tiempo-real",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>`,
    title: "Dashboards en Tiempo Real",
    shortDesc: "Tus KPIs en un vistazo. Decisiones con datos, no con intuición.",
    color: "blue"
  },
  {
    id: "creacion-formularios",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 2h6"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>`,
    title: "Captura de Datos Inteligente",
    shortDesc: "Formularios que validan y organizan la información automáticamente.",
    color: "indigo"
  },
  {
    id: "formularios-leads-magnet",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    title: "Lead Magnet & Captación",
    shortDesc: "Tu web vendiendo por ti. Embudos que califican al cliente al instante.",
    color: "violet"
  }
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "name": "Konte Solutions",
      "url": "https://konte.es",
      "description": "Agencia de software a medida para PYMES. Especialistas en Google Sheets, AppScript, automatización y dashboards en tiempo real sin costes de mantenimiento mensual.",
      "areaServed": "España",
      "serviceType": ["Automatización Google Sheets", "Desarrollo AppScript", "Dashboards Looker Studio", "Software a Medida PYME"]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Por qué no pago mantenimiento mensual?", "acceptedAnswer": { "@type": "Answer", "text": "Porque nuestro software corre directamente sobre la infraestructura de Google Workspace. No hay servidores propios que mantener. El sistema vive en tu cuenta de Google y tú eres el propietario total del código y los datos." } },
        { "@type": "Question", "name": "¿Es seguro usar Google Sheets como base de datos para mi empresa?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Google Workspace cumple con ISO 27001, SOC 2 y SOC 3, con cifrado en tránsito y en reposo. Para la mayoría de PYMES es más seguro que un servidor propio." } },
        { "@type": "Question", "name": "¿Cuánto cuesta un proyecto de software a medida con Konte?", "acceptedAnswer": { "@type": "Answer", "text": "Cada proyecto se presupuesta individualmente: desde mejoras de hojas de cálculo (300-500€) hasta aplicaciones web completas (2.500-8.000€). El pago es único y no hay cuotas mensuales." } },
        { "@type": "Question", "name": "¿Puedo automatizar procesos en Google Sheets sin saber programar?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Nosotros nos encargamos de toda la programación en Google Apps Script. Tú describes el proceso y nosotros lo implementamos con formación incluida." } },
        { "@type": "Question", "name": "¿En cuánto tiempo estará listo mi proyecto?", "acceptedAnswer": { "@type": "Answer", "text": "Las automatizaciones simples pueden estar listas en 1-2 semanas. Las aplicaciones web completas se entregan en 4-8 semanas según la complejidad." } },
        { "@type": "Question", "name": "¿Funciona si ya tenemos muchos datos en Excel?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Google Sheets importa archivos .xlsx de forma nativa conservando fórmulas y datos. Realizamos la migración como parte del proyecto." } }
      ]
    }
  ]
});
---

<Layout
  title="Konte | Software a Medida para PYMES con Google Sheets y AppScript"
  description="Digitaliza tu PYME con software a medida sin costes de mantenimiento. Especialistas en Google Workspace, AppScript y Looker Studio. ¡Agenda tu diagnóstico gratuito!"
  jsonLd={jsonLd}
>
  <!-- ===================== NAVBAR ===================== -->
  <nav id="main-nav" class="fixed w-full top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-200 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-18 py-3">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 bg-lightAccent text-white flex items-center justify-center font-display font-black text-2xl rotate-3 group-hover:rotate-0 transition-transform shadow-[3px_3px_0_0_rgba(0,0,0,0.15)]">K</div>
          <span class="font-display font-bold text-2xl tracking-tight uppercase text-gray-900">Konte</span>
        </a>

        <!-- Nav Links (desktop) -->
        <div class="hidden md:flex items-center gap-8">
          <a href="#proyectos" class="text-sm font-bold text-gray-600 hover:text-lightAccent transition-colors">Proyectos</a>
          <a href="/servicios" class="relative text-sm font-bold text-lightAccent transition-colors group">
            Servicios
            <span class="absolute -top-1 -right-4 bg-lightAccent text-white text-[7.5px] font-black px-1.5 py-0.5 rounded-full uppercase tracking-wide leading-none">+6</span>
          </a>
          <a href="/blog" class="text-sm font-bold text-gray-600 hover:text-lightAccent transition-colors">Blog</a>
          <a href="#faq" class="text-sm font-bold text-gray-600 hover:text-lightAccent transition-colors">FAQ</a>
        </div>

        <!-- CTAs -->
        <div class="flex items-center gap-3">
          <a href="#contacto" class="hidden md:flex items-center gap-2 text-sm font-bold text-gray-700 hover:text-lightAccent transition-colors border border-gray-300 hover:border-lightAccent px-4 py-2 rounded-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Escribir
          </a>
          <button id="nav-calendly-btn" class="px-5 py-2.5 bg-lightAccent text-white font-bold text-sm tracking-wide rounded-sm hover:-translate-y-0.5 transition-transform shadow-[3px_3px_0_0_rgba(0,0,0,0.2)] hover:shadow-[1px_1px_0_0_rgba(0,0,0,0.2)]">
            Agendar llamada gratis →
          </button>
          <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-900" aria-label="Abrir menú">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-gray-200 px-4 py-4 space-y-3">
      <a href="#proyectos" class="block text-base font-bold text-gray-900 hover:text-lightAccent transition-colors">Proyectos</a>
      <a href="/servicios" class="block text-base font-bold text-lightAccent transition-colors">Servicios →</a>
      <a href="/blog" class="block text-base font-bold text-gray-900 hover:text-lightAccent transition-colors">Blog</a>
      <a href="#faq" class="block text-base font-bold text-gray-900 hover:text-lightAccent transition-colors">FAQ</a>
      <a href="#contacto" class="block text-base font-bold text-gray-900 hover:text-lightAccent transition-colors">Contacto</a>
      <button id="mobile-calendly-btn" class="w-full py-3 bg-lightAccent text-white font-black text-sm uppercase tracking-widest rounded-sm">Agendar llamada gratis</button>
    </div>
  </nav>

  <main class="pt-20">

    <!-- ===================== HERO ===================== -->
    <section class="relative bg-white overflow-hidden min-h-[92vh] flex items-center">
      <!-- Background grid -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:64px_64px] opacity-40 pointer-events-none"></div>
      <!-- Glow -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-lightAccent/10 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
        <!-- Social proof badge -->
        <div class="inline-flex items-center gap-3 bg-blue-50 border border-blue-200 rounded-full px-5 py-2 mb-8 animate-fade-in">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-lightAccent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-lightAccent"></span>
          </span>
          <span class="text-sm font-bold text-lightAccent uppercase tracking-wider">+100 proyectos entregados · 0€/mes de mantenimiento</span>
        </div>

        <!-- Main headline -->
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-black mb-6 text-gray-900 uppercase leading-[0.85] tracking-tighter">
          Tu empresa.<br/>
          <span class="text-lightAccent relative">
            Automatizada.
            <svg class="absolute bottom-[4px] left-0 w-full" height="8" viewBox="0 0 400 8" preserveAspectRatio="none"><path d="M0 7 Q100 1 200 5 Q300 9 400 3" stroke="#0055FF" stroke-width="3" fill="none" opacity="0.4"/></svg>
          </span><br/>
          Sin cuotas mensuales.
        </h1>

        <p class="text-xl md:text-2xl text-gray-600 mb-12 max-w-3xl mx-auto font-medium leading-relaxed">
          Construimos <strong>software a medida sobre Google Workspace</strong>: apps de gestión, dashboards en tiempo real y automatizaciones. Pago único. El código es tuyo para siempre.
        </p>

        <!-- Hero CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
          <button id="hero-calendly-btn" class="group inline-flex items-center justify-center gap-3 px-10 py-5 bg-lightAccent text-white font-black text-lg uppercase tracking-wide rounded-sm hover:-translate-y-1 transition-all shadow-[6px_6px_0_0_rgba(0,0,0,0.15)] hover:shadow-[2px_2px_0_0_rgba(0,0,0,0.15)]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Agendar llamada gratis
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </button>
          <a href="/servicios" class="group inline-flex items-center justify-center gap-3 px-10 py-5 bg-white text-gray-900 font-black text-lg uppercase tracking-wide rounded-sm border-2 border-gray-900 hover:-translate-y-1 transition-all shadow-[6px_6px_0_0_rgba(0,0,0,0.15)] hover:shadow-[2px_2px_0_0_rgba(0,0,0,0.15)] hover:border-lightAccent hover:text-lightAccent">
            Ver todos los servicios
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="flex flex-wrap justify-center gap-8 text-sm font-bold text-gray-500 uppercase tracking-widest">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Sin cuota mensual
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Código 100% tuyo
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            1-8 semanas de entrega
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Infraestructura Google
          </span>
        </div>
      </div>
    </section>

    <!-- ===================== STATS COUNTER ===================== -->
    <section class="bg-gray-900 py-14 border-y border-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div class="group">
            <div class="font-display text-5xl md:text-6xl font-black text-lightAccent mb-2 counter-number" data-target="100">0</div>
            <div class="text-xs font-black uppercase tracking-widest text-gray-400">Proyectos entregados</div>
          </div>
          <div class="group">
            <div class="font-display text-5xl md:text-6xl font-black text-white mb-2">0€</div>
            <div class="text-xs font-black uppercase tracking-widest text-gray-400">Mantenimiento mensual</div>
          </div>
          <div class="group">
            <div class="font-display text-5xl md:text-6xl font-black text-lightAccent mb-2">100%</div>
            <div class="text-xs font-black uppercase tracking-widest text-gray-400">Propiedad del código</div>
          </div>
          <div class="group">
            <div class="font-display text-5xl md:text-6xl font-black text-white mb-2">6</div>
            <div class="text-xs font-black uppercase tracking-widest text-gray-400">Sectores atendidos</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== WHAT I DO (SERVICES GRID) ===================== -->
    <section id="servicios-home" class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-16">
          <div class="inline-block px-4 py-2 bg-gray-900 text-white font-bold text-xs uppercase tracking-widest mb-6">Lo que hacemos</div>
          <h2 class="font-display text-4xl md:text-6xl font-black uppercase mb-6 leading-tight text-gray-900">
            Soluciones que <span class="text-lightAccent">transforman</span><br/>cómo opera tu empresa
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto font-medium">
            Todo construido sobre Google Workspace. Sin servidores caros. Sin dependencia de terceros.
          </p>
        </div>

        <!-- Services Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          {services.map((svc, i) => (
            <a href={`/servicios#${svc.id}`} class="group relative bg-white border-2 border-gray-200 rounded-2xl p-8 hover:border-lightAccent hover:-translate-y-2 transition-all duration-300 hover:shadow-[8px_8px_0_0_rgba(0,85,255,0.1)] flex flex-col">
              <!-- Number -->
              <span class="absolute top-6 right-6 font-display text-5xl font-black text-gray-100 group-hover:text-blue-50 transition-colors">0{i + 1}</span>
              <!-- Icon -->
              <div class="w-14 h-14 text-lightAccent bg-blue-50 p-3.5 rounded-xl border border-blue-100 group-hover:bg-lightAccent group-hover:text-white transition-all duration-300 mb-6 relative z-10" set:html={svc.icon} />
              <!-- Content -->
              <h3 class="font-display text-xl font-black uppercase tracking-tight mb-3 text-gray-900 group-hover:text-lightAccent transition-colors relative z-10">{svc.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed font-medium flex-1 relative z-10">{svc.shortDesc}</p>
              <!-- CTA -->
              <div class="mt-6 flex items-center gap-2 text-xs font-black uppercase tracking-widest text-lightAccent opacity-0 group-hover:opacity-100 transition-opacity relative z-10">
                Ver detalles <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>

