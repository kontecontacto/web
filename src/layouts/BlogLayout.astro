---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: string;
  need?: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogImage, jsonLd, need, ogType = 'article' } = Astro.props;
---

<Layout title={title} description={description} ogImage={ogImage} ogType={ogType} jsonLd={jsonLd} contactProps={{ need }}>
  <div class="bg-white">
    <slot />
  </div>
</Layout>
