---
import WhatsAppIcon from './WhatsAppIcon.astro';
import ContactForm from './ContactForm.astro';
import { SITE, whatsappLink } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
  need?: string;
  source?: string;
}

const {
  title = 'Cuéntanos qué necesitas.',
  subtitle = 'Te decimos cómo lo haríamos, cuánto tardaríamos y cuánto costaría. Gratis y sin compromiso. Si una herramienta que ya existe te sirve, también te lo diremos.',
  need = '',
  source = Astro.url.pathname,
} = Astro.props;
---

<section id="contacto" class="py-20 md:py-24 bg-gray-900 relative overflow-hidden">
  <div class="absolute -top-32 -left-32 w-[480px] h-[480px] bg-lightAccent/20 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-x-16 gap-y-10 items-start">
      <div class="lg:col-start-1 lg:row-start-1">
        <div class="inline-block px-4 py-2 bg-lightAccent text-white font-bold text-xs uppercase tracking-widest mb-6">Presupuesto gratis en 48 h</div>
        <h2 class="font-display text-4xl md:text-5xl font-black uppercase mb-6 text-white leading-[0.95]">{title}</h2>
        <p class="text-gray-300 text-lg mb-8 leading-relaxed">{subtitle}</p>

        <ul class="space-y-3">
          {['Llamada o videollamada de 30 minutos para entender tu negocio', 'Propuesta clara con plazos y precio cerrado', 'Te recomendamos la opción más rentable: nube o Google Workspace', 'Trato directo con quien desarrolla, sin intermediarios'].map((item) => (
            <li class="flex items-start gap-3 text-gray-300 font-medium">
              <span class="mt-0.5 w-6 h-6 bg-lightAccent/20 border border-lightAccent/40 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-3 h-3 text-lightAccent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-start-2 lg:row-start-1 lg:row-span-2 bg-white rounded-2xl p-6 sm:p-8 md:p-10 shadow-2xl">
        <h3 class="font-display text-2xl font-black uppercase mb-1 text-gray-900">Pide tu presupuesto</h3>
        <p class="text-gray-500 text-sm mb-6 font-medium">Solo te llevará 1 minuto. Los campos con * son obligatorios.</p>
        <ContactForm id="form-contacto" source={source} need={need} />
      </div>
      <div class="lg:col-start-1 lg:row-start-2">
        <p class="text-xs font-black uppercase tracking-widest text-gray-500 mb-4">¿Prefieres hablar directamente?</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-4 bg-[#25D366] hover:bg-[#128C7E] text-white rounded-xl transition-colors">
            <WhatsAppIcon class="w-6 h-6 flex-shrink-0" />
            <span><span class="block text-[10px] font-black uppercase tracking-widest opacity-80">WhatsApp</span><span class="block font-black">Escríbenos ahora</span></span>
          </a>
          <a href={SITE.phoneHref} class="flex items-center gap-3 p-4 bg-white/5 border border-white/15 hover:border-lightAccent text-white rounded-xl transition-colors">
            <svg class="w-6 h-6 text-lightAccent flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
            <span><span class="block text-[10px] font-black uppercase tracking-widest text-gray-400">Llámanos</span><span class="block font-black">{SITE.phone}</span></span>
          </a>
          <a href={`mailto:${SITE.email}`} class="flex items-center gap-3 p-4 bg-white/5 border border-white/15 hover:border-lightAccent text-white rounded-xl transition-colors">
            <svg class="w-6 h-6 text-lightAccent flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            <span class="min-w-0"><span class="block text-[10px] font-black uppercase tracking-widest text-gray-400">Email</span><span class="block font-black truncate">{SITE.email}</span></span>
          </a>
          <button type="button" data-calendly class="flex items-center gap-3 p-4 bg-white/5 border border-white/15 hover:border-lightAccent text-white rounded-xl transition-colors text-left">
            <svg class="w-6 h-6 text-lightAccent flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/></svg>
            <span><span class="block text-[10px] font-black uppercase tracking-widest text-gray-400">Videollamada</span><span class="block font-black">Elegir día y hora</span></span>
          </button>
        </div>
      </div>

    </div>
  </div>
</section>
