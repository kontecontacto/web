---
import { SOLUTIONS } from '../data/soluciones';

interface Props {
  only?: string[];
  showOther?: boolean;
}

const { only, showOther = true } = Astro.props;
const list = only ? only.map((slug) => SOLUTIONS.find((s) => s.slug === slug)!).filter(Boolean) : SOLUTIONS;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5">
  {list.map((s) => (
    <a href={`/soluciones/${s.slug}/`} class="group relative bg-white border-2 border-gray-200 rounded-2xl overflow-hidden hover:border-lightAccent hover:-translate-y-1 transition-all duration-300 hover:shadow-[8px_8px_0_0_rgba(0,85,255,0.12)] flex flex-row sm:flex-col">
      <!-- Imagen: miniatura a la izquierda en móvil, cabecera en escritorio -->
      <div class="relative flex-shrink-0 w-28 sm:w-full sm:aspect-[16/10] bg-gradient-to-br from-blue-50 via-white to-blue-100 overflow-hidden">
        <img
          src={s.image}
          alt=""
          aria-hidden="true"
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-contain p-2 sm:p-3 mix-blend-multiply group-hover:scale-105 transition-transform duration-500"
        />
        <span class="hidden sm:flex absolute top-3 left-3 w-9 h-9 text-lightAccent bg-white/90 backdrop-blur p-2 rounded-lg border border-blue-100 shadow-sm" set:html={s.svg} />
      </div>
      <div class="flex flex-col flex-1 p-4 sm:p-6">
        <h3 class="font-display text-base sm:text-lg font-black uppercase tracking-tight mb-1 sm:mb-2 text-gray-900 group-hover:text-lightAccent transition-colors">{s.name} <span class="sm:hidden text-lightAccent">→</span></h3>
        <p class="text-sm text-gray-600 leading-relaxed font-medium flex-1">{s.cardDesc}</p>
        <span class="hidden sm:inline-flex mt-4 items-center gap-2 text-xs font-black uppercase tracking-widest text-lightAccent">
          Ver solución <span class="group-hover:translate-x-1 transition-transform">→</span>
        </span>
      </div>
    </a>
  ))}
  {showOther && (
    <a href="#contacto" data-need="Otra cosa / no lo tengo claro" class="group relative bg-gray-900 border-2 border-gray-900 rounded-2xl p-5 sm:p-7 hover:-translate-y-1 transition-all duration-300 hover:shadow-[8px_8px_0_0_rgba(0,85,255,0.3)] flex flex-col justify-center overflow-hidden">
      <div class="absolute -top-16 -right-16 w-48 h-48 bg-lightAccent/30 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative w-11 h-11 sm:w-14 sm:h-14 text-white bg-lightAccent p-2.5 sm:p-3 rounded-xl mb-4 sm:mb-6">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V17h6v-.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z"/></svg>
      </div>
      <h3 class="relative font-display text-xl sm:text-2xl font-black uppercase tracking-tight mb-2 text-white">¿Tienes otra idea?</h3>
      <p class="relative text-sm text-gray-400 leading-relaxed font-medium">Si se puede programar, lo desarrollamos. Cuéntanos qué quieres resolver y te decimos cómo.</p>
      <span class="relative mt-5 inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-lightAccent">
        Contar mi idea <span class="group-hover:translate-x-1 transition-transform">→</span>
      </span>
    </a>
  )}
</div>
