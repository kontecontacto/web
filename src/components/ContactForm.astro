---
import { NEEDS, SITE, whatsappLink } from '../data/site';

interface Props {
  id: string;
  source: string;
  need?: string;
  submitLabel?: string;
  messagePlaceholder?: string;
}

const {
  id,
  source,
  need = '',
  submitLabel = 'Pedir presupuesto gratis',
  messagePlaceholder = 'Ej.: Tenemos una clínica con 4 fisios y queremos que los pacientes reserven online y reciban recordatorios por WhatsApp.',
} = Astro.props;

const field = 'w-full px-3.5 py-3 bg-gray-50 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-lightAccent focus:bg-white transition-colors text-gray-900 font-medium text-sm';
const label = 'block text-[11px] font-black uppercase tracking-widest text-gray-700 mb-1.5';
---

<div data-form-wrap>
  <form id={id} data-konte-form data-subject="Nuevo contacto desde konte.es" class="space-y-4" novalidate>
    <input type="hidden" name="origen" value={source} />
    <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for={`${id}-nombre`} class={label}>Nombre *</label>
        <input id={`${id}-nombre`} type="text" name="nombre" required autocomplete="name" placeholder="Tu nombre" class={field} />
      </div>
      <div>
        <label for={`${id}-email`} class={label}>Email *</label>
        <input id={`${id}-email`} type="email" name="email" required autocomplete="email" placeholder="tu@empresa.com" class={field} />
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for={`${id}-telefono`} class={label}>Teléfono / WhatsApp</label>
        <input id={`${id}-telefono`} type="tel" name="telefono" autocomplete="tel" placeholder="Opcional" class={field} />
      </div>
      <div>
        <label for={`${id}-necesidad`} class={label}>¿Qué necesitas?</label>
        <select id={`${id}-necesidad`} name="necesidad" data-need-select class={field}>
          <option value="" selected={!need}>Elige una opción…</option>
          {NEEDS.map((n) => <option value={n} selected={n === need}>{n}</option>)}
        </select>
      </div>
    </div>
    <div>
      <label for={`${id}-mensaje`} class={label}>Cuéntanos tu idea <span class="normal-case tracking-normal font-medium text-gray-400">(opcional)</span></label>
      <textarea id={`${id}-mensaje`} name="mensaje" rows="3" placeholder={messagePlaceholder} class={`${field} resize-none`}></textarea>
    </div>
    <p data-form-error-inline class="hidden text-sm font-bold text-red-600"></p>
    <button type="submit" class="w-full py-4 px-3 bg-lightAccent text-white font-black text-sm sm:text-base uppercase tracking-wider rounded-lg hover:bg-gray-900 transition-colors duration-300 flex items-center justify-center gap-2 group shadow-[4px_4px_0_0_rgba(0,0,0,0.15)]">
      <span data-submit-label>{submitLabel}</span>
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    </button>
    <p class="text-center text-xs text-gray-500">
      Respuesta en menos de 24 h laborables · Sin compromiso ·
      <a href="/privacidad/" class="underline hover:text-lightAccent">Privacidad</a>
    </p>
  </form>

  <div data-form-success class="hidden text-center py-6">
    <div class="w-16 h-16 mx-auto mb-5 rounded-full bg-green-100 text-green-600 flex items-center justify-center">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
    </div>
    <p class="font-display text-2xl font-black uppercase text-gray-900 mb-2">¡Recibido!</p>
    <p class="text-gray-600 mb-6">Te respondemos en menos de 24 h laborables a tu email. Si lo prefieres, puedes adelantarte y escribirnos ahora:</p>
    <a data-success-whatsapp href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#25D366] hover:bg-[#128C7E] text-white font-black text-sm uppercase tracking-widest rounded-lg transition-colors">
      Continuar por WhatsApp
    </a>
  </div>

  <div data-form-failure class="hidden text-center py-6">
    <p class="font-display text-xl font-black uppercase text-gray-900 mb-2">No hemos podido enviar el formulario</p>
    <p class="text-gray-600 mb-6">No pierdas tu consulta: envíanosla por WhatsApp o email con un clic, ya va escrita.</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a data-failure-whatsapp href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#25D366] hover:bg-[#128C7E] text-white font-black text-sm uppercase tracking-widest rounded-lg transition-colors">Enviar por WhatsApp</a>
      <a data-failure-email href={`mailto:${SITE.email}`} class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gray-900 text-white font-black text-sm uppercase tracking-widest rounded-lg">Enviar por email</a>
    </div>
  </div>
</div>
