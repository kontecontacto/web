---
// src/components/WhatsAppWidget.astro
import { whatsappLink } from '../data/site';
---

<div class="hidden md:block fixed bottom-8 right-8 z-50 font-sans" id="whatsapp-widget-container">
  <!-- Notification Badge on floating button -->
  <div class="relative">
    <!-- Pulse ring -->
    <div class="absolute inset-0 rounded-full whatsapp-pulse bg-[#25D366]/40 pointer-events-none"></div>
    
    <!-- Floating button -->
    <button
      id="whatsapp-btn"
      class="relative flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 bg-[#25D366] hover:bg-[#128C7E] text-white rounded-full shadow-2xl transition-all duration-300 hover:scale-110 focus:outline-none group z-10"
      aria-label="Contactar por WhatsApp"
    >
      <!-- Icon -->
      <svg class="w-7 h-7 sm:w-8 sm:h-8 fill-current" viewBox="0 0 24 24">
        <path d="M12.01 2.003c-5.502 0-9.973 4.47-9.973 9.973 0 1.76.456 3.475 1.324 4.992L2 22l5.163-1.353a9.92 9.92 0 0 0 4.846 1.229c5.503 0 9.974-4.47 9.974-9.973 0-2.657-1.035-5.155-2.914-7.035a9.907 9.907 0 0 0-7.059-2.915zm0 1.702c2.2 0 4.27.856 5.828 2.415 1.558 1.558 2.415 3.627 2.415 5.856 0 4.566-3.715 8.28-8.28 8.28-1.442 0-2.857-.376-4.108-1.088l-.295-.175-3.056.8 1.01-2.977-.193-.306A8.204 8.204 0 0 1 3.712 12c0-4.565 3.715-8.28 8.28-8.28zm3.842 11.232c-.21-.105-1.246-.614-1.44-.684-.193-.07-.333-.105-.473.105-.14.21-.543.684-.666.824-.124.14-.246.158-.456.053-.21-.105-.888-.327-1.693-1.045-.625-.558-1.047-1.248-1.17-1.458-.123-.21-.013-.323.092-.427.095-.095.21-.246.315-.369.105-.123.14-.21.21-.35.07-.14.035-.263-.017-.369-.053-.105-.473-1.14-.648-1.56-.172-.413-.347-.35-.473-.35-.123-.005-.263-.005-.403-.005-.14 0-.368.053-.56.263-.193.21-.737.72-.737 1.754s.754 2.035.86 2.175c.105.14 1.484 2.266 3.597 3.178.503.217.895.347 1.2.443.51.162.974.139 1.34.084.408-.06 1.246-.51 1.421-1.002.175-.49.175-.91.123-1.002-.053-.092-.193-.14-.403-.245"/>
      </svg>
      
      <!-- Unread indicator dot -->
      <span id="whatsapp-unread-dot" class="absolute -top-1 -right-1 flex h-4 w-4 z-20">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-4 w-4 bg-red-500 text-[10px] text-white items-center justify-center font-bold font-sans">1</span>
      </span>
    </button>
  </div>

  <!-- Chat Bubble Dialog -->
  <div
    id="whatsapp-chat-bubble"
    class="absolute bottom-18 sm:bottom-20 right-0 w-[310px] sm:w-[340px] bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden transform scale-90 opacity-0 pointer-events-none transition-all duration-300 origin-bottom-right"
  >
    <!-- Header -->
    <div class="bg-gradient-to-r from-[#075e54] to-[#128c7e] text-white px-4 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <!-- Avatar -->
        <div class="relative w-10 h-10 rounded-full bg-white/20 flex items-center justify-center font-bold text-lg border border-white/20">
          M
          <!-- Active Green Dot -->
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 border-2 border-[#075e54] rounded-full"></span>
        </div>
        <div>
          <div class="font-bold text-sm leading-tight text-white">Martín (Konte)</div>
          <div class="text-[11px] text-green-300 font-medium">En línea</div>
        </div>
      </div>
      <!-- Close Button -->
      <button id="whatsapp-chat-close" class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/10 transition-colors" aria-label="Cerrar chat">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="bg-[#e5ddd5] p-4 min-h-[120px] flex flex-col justify-between relative">
      <!-- Message -->
      <div class="bg-white text-gray-800 p-3 rounded-lg rounded-tl-none shadow-sm text-sm relative max-w-[90%] self-start animate-fade-in">
        <p class="font-sans leading-relaxed text-gray-800">¡Hola! 👋 Soy Martín de Konte. ¿Necesitas un CRM, un sistema de turnos, de tickets o cualquier otra herramienta? Cuéntame tu idea y te digo cómo lo haríamos.</p>
        <span class="block text-[9px] text-gray-400 text-right mt-1.5 font-sans" id="chat-timestamp">12:00</span>
      </div>
    </div>

    <!-- Footer / Mock Input -->
    <div class="p-3 bg-gray-50 border-t border-gray-150">
      <a
        id="whatsapp-chat-link"
        href={whatsappLink('Hola Martín, vengo de konte.es y quiero contaros una idea.')}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between w-full bg-white border border-gray-200 rounded-full px-4 py-2.5 hover:border-gray-300 transition-colors group"
      >
        <span class="text-xs sm:text-sm text-gray-400 font-sans">Escribe tu consulta por WhatsApp...</span>
        <div class="bg-[#128c7e] text-white p-1.5 rounded-full group-hover:scale-105 transition-transform flex items-center justify-center">
          <svg class="w-4 h-4 fill-current rotate-45 transform translate-x-[1px]" viewBox="0 0 24 24">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
          </svg>
        </div>
      </a>
    </div>
  </div>
</div>

<style>
  /* Pulse Ring keyframes */
  @keyframes pulse-ring {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 14px rgba(37, 211, 102, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }
  .whatsapp-pulse {
    animation: pulse-ring 2.5s infinite;
  }

  /* Show Chat transition helper classes */
  .show-chat {
    transform: scale(1) !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
</style>

<script>
  // Dynamic behavior run on client
  function initWhatsAppWidget() {
    const container = document.getElementById('whatsapp-widget-container');
    const btn = document.getElementById('whatsapp-btn');
    const bubble = document.getElementById('whatsapp-chat-bubble');
    const closeBtn = document.getElementById('whatsapp-chat-close');
    const unreadDot = document.getElementById('whatsapp-unread-dot');
    const chatTimestamp = document.getElementById('chat-timestamp');
    const chatLink = document.getElementById('whatsapp-chat-link');

    if (!btn || !bubble || !closeBtn || !container) return;

    // Set real time stamp
    if (chatTimestamp) {
      const now = new Date();
      const hrs = now.getHours().toString().padStart(2, '0');
      const mins = now.getMinutes().toString().padStart(2, '0');
      chatTimestamp.textContent = `${hrs}:${mins}`;
    }

    // Toggle bubble
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      bubble.classList.toggle('show-chat');
      
      // Hide unread dot when user clicks the widget
      if (unreadDot) {
        unreadDot.classList.add('hidden');
      }
    });

    // Close bubble
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      bubble.classList.remove('show-chat');
      // Save in sessionStorage that user closed it, so we don't open it automatically again this session
      sessionStorage.setItem('wa-bubble-closed', 'true');
    });

    // Close if click outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (bubble.classList.contains('show-chat') && !container.contains(target)) {
        bubble.classList.remove('show-chat');
      }
    });

    // Handle direct click on mock input
    chatLink?.addEventListener('click', () => {
      bubble.classList.remove('show-chat');
      if (unreadDot) {
        unreadDot.classList.add('hidden');
      }
    });

    // Auto show bubble after 4 seconds if not closed before
    const isClosedBefore = sessionStorage.getItem('wa-bubble-closed');
    if (!isClosedBefore) {
      setTimeout(() => {
        // Double check if user hasn't already clicked it
        if (!bubble.classList.contains('show-chat')) {
          bubble.classList.add('show-chat');
        }
      }, 8000);
    }
  }

  // Run on page load & View Transitions (if used in Astro)
  document.addEventListener('DOMContentLoaded', initWhatsAppWidget);
  document.addEventListener('astro:page-load', initWhatsAppWidget);
</script>
