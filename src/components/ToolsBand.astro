---
// Banda de herramientas gratuitas (captación): turnero online y plantilla CRM.
interface Props {
  title?: string;
}
const { title = 'Herramientas gratis para tu negocio' } = Astro.props;

const tools = [
  {
    href: '/turnero-online-gratis/',
    tag: 'App gratis',
    title: 'Turnero online',
    desc: 'Pantalla de turnos para tu TV con aviso por voz, varias colas y tickets. Sin instalar nada.',
    cta: 'Usar gratis',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M8.5 9.5h2v3M13 9.5h2.5l-2 3"/></svg>',
  },
  {
    href: '/plantilla-crm-gratis/',
    tag: 'Descarga gratis',
    title: 'Plantilla CRM',
    desc: 'Clientes, embudo de ventas, seguimientos y panel automático para Excel y Google Sheets.',
    cta: 'Descargar',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"/><path d="M3 9h18M9 3v18"/><path d="M13 13l2 2 4-4"/></svg>',
  },
];
---

<section class="py-16 md:py-20 bg-lightAccent relative overflow-hidden">
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.08)_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <span class="inline-block px-3 py-1 bg-white text-lightAccent text-[10px] font-black uppercase tracking-widest rounded mb-4">100% gratis</span>
      <h2 class="font-display text-3xl md:text-5xl font-black uppercase text-white leading-[0.95]">{title}</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {tools.map((t) => (
        <a href={t.href} class="group flex gap-5 items-start p-6 md:p-8 bg-white rounded-2xl shadow-[8px_8px_0_0_rgba(0,0,0,0.2)] hover:-translate-y-1 transition-transform">
          <span class="w-14 h-14 flex-shrink-0 rounded-xl bg-blue-50 text-lightAccent p-3" set:html={t.icon} />
          <span class="flex-1">
            <span class="block text-[10px] font-black uppercase tracking-widest text-green-600 mb-1">{t.tag}</span>
            <span class="block font-display text-2xl font-black uppercase text-gray-900 mb-2">{t.title}</span>
            <span class="block text-gray-600 mb-4">{t.desc}</span>
            <span class="inline-flex items-center gap-2 text-sm font-black uppercase tracking-widest text-lightAccent">{t.cta} <span class="group-hover:translate-x-1 transition-transform">→</span></span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
