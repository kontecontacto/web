---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { SITE, whatsappLink } from '../data/site';
---

<!-- Barra fija en móvil: los tres caminos para contactar siempre a mano -->
<div class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-gray-200 shadow-[0_-6px_20px_rgba(0,0,0,0.08)] pb-[env(safe-area-inset-bottom)]">
  <div class="grid grid-cols-3 text-[11px] font-black uppercase tracking-wide">
    <a href={SITE.phoneHref} class="flex flex-col items-center justify-center gap-1 py-2.5 text-gray-900">
      <svg class="w-5 h-5 text-lightAccent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
      Llamar
    </a>
    <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-1 py-2.5 text-white bg-[#25D366]">
      <WhatsAppIcon class="w-5 h-5" />
      WhatsApp
    </a>
    <a href="#contacto" class="flex flex-col items-center justify-center gap-1 py-2.5 text-white bg-lightAccent">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/><path d="M8 13h8M8 17h5"/></svg>
      Presupuesto
    </a>
  </div>
</div>
